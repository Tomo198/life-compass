{
  "name": "life-compass",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "npm run build && wrangler dev",
    "test:logic": "node scripts/run-logic-tests.mjs",
    "test:e2e": "npm run build && node scripts/run-e2e.mjs",
    "test:e2e:headed": "npm run build && node scripts/run-e2e.mjs --headed",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.42.4",
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "wrangler": "^4.106.0"
  }
}
